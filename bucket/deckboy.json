            "extract_dir": "Deckboy-0.99.408-windows-x64"
        }
    },
    "env_set": {
        "DECKBOY_STATE_DIR": "$persist_dir\\state"
    },
    "persist": "state",
    "bin": "Deckboy.exe",
    "shortcuts": [
        [
            "Deckboy.exe",
            "Deckboy"
        ]
    ],
    "checkver": {
